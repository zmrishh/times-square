# Local development works without credentials. Never use local modes in production.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Paper Square
SUPPORT_EMAIL=
AUTH_MODE=local
PAYMENT_MODE=simulation

# Deployment: pooled PostgreSQL URL with a server-only role that bypasses RLS.
DATABASE_URL=
# Bound this to the managed database connection budget (default 8, range 1–20).
DATABASE_POOL_MAX=8
# Supabase OTP authentication (email template must show {{ .Token }}).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PRIVATE test bucket. Live mode requires paper-assets-live and uses paper_live tables.
SUPABASE_STORAGE_BUCKET=paper-assets

# PAYMENT_MODE=dodo-test (then dodo-live only after explicit product acceptance)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
DODO_BUSINESS_ID=
DODO_LIVE_ACCEPTANCE=

# A long random secret, shared by app and durable worker / scheduler.
JOB_SECRET=
# For local isolated tests only; defaults to .data/postgres.
# PAPER_DATA_DIR=.data/postgres
# PAPER_UPLOAD_DIR=.data/uploads
